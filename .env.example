# ── SpecForge AI configuration ────────────────────────────────────────────────
# The pipeline auto-detects whichever key is present, in this priority order:
#   AI_* (any OpenAI-compatible endpoint) > GLM > Google Gemini >
#   OpenRouter > NVIDIA NIM.
# Without any key the app runs fully in deterministic Demo Mode.

# Option 1 — Google Gemini (free tier, https://aistudio.google.com)
GOOGLE_API_KEY=

# Option 2 — GLM (https://open.bigmodel.cn or https://z.ai)
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Option 3 — OpenRouter (https://openrouter.ai; model names like "z-ai/glm-4.6")
OPENROUTER_API_KEY=

# Option 4 — NVIDIA NIM (https://build.nvidia.com)
NEMOTRON_API_KEY=

# Option 5 — any OpenAI-compatible provider (takes priority over all above)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: overrides the resolved provider's default model
# Gemini current default: gemini-3.6-flash (2.5/2.0 models are retired)
# AI_MODEL=gemini-3.6-flash
